<!doctype html>
<html>
<head>
    <meta charset="utf-8">
    <title>CWE List</title>
    <style>
        body {
            font-family: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial;
            padding: 24px;
        }
        table {
            border-collapse: collapse;
            width: 100%;
        }
        th, td {
            border: 1px solid #ddd;
            padding: 8px;
        }
        th {
            background: #f5f5f5;
            text-align: left;
        }
        .active {
            font-weight: bold;
            color: darkred;
        }
    </style>
</head>
<body>
<h1>CWE list</h1>

<p>Sort:
    <a href="/?column=e.cweId&direction=ASC"
       class="{{ orderColumn == 'e.cweId' and orderDirection == 'ASC' ? 'active' }}">
        CWE ↑
    </a> |
    <a href="/?column=e.cweId&direction=DESC"
       class="{{ orderColumn == 'e.cweId' and orderDirection == 'DESC' ? 'active' }}">
        CWE ↓
    </a> |
    <a href="/?column=e.name&direction=ASC"
       class="{{ orderColumn == 'e.name' and orderDirection == 'ASC' ? 'active' }}">
        Name ↑
    </a> |
    <a href="/?column=e.name&direction=DESC"
       class="{{ orderColumn == 'e.name' and orderDirection == 'DESC' ? 'active' }}">
        Name ↓
    </a> |
    <a href="/?column=e.description&direction=ASC"
       class="{{ orderColumn == 'e.description' and orderDirection == 'ASC' ? 'active' }}">
        Description ↑
    </a> |
    <a href="/?column=e.description&direction=DESC"
       class="{{ orderColumn == 'e.description' and orderDirection == 'DESC' ? 'active' }}">
        Description ↓
    </a>
</p>

<table>
    <thead>
    <tr><th>CWE</th><th>Name</th><th>Description</th></tr>
    </thead>
    <tbody>
    {% for c in cwes %}
        <tr>
            <td>{{ c.getCweId() }}</td>
            <td>{{ c.getName() }}</td>
            <td>{{ c.getDescription() }}</td>
        </tr>
    {% else %}
        <tr><td colspan="3">No entries</td></tr>
    {% endfor %}
    </tbody>
</table>
</body>
</html>
