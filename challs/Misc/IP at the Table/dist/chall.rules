#!/bin/bash
# Configuration iptables - Serveur Web Production
# Osiris

# Nettoyage des règles existantes
iptables -F
iptables -X
iptables -t nat -F
iptables -t nat -X

# Politique par défaut
iptables -P INPUT DROP
iptables -P FORWARD DROP
iptables -P OUTPUT ACCEPT

# Interface de loopback
iptables -A INPUT -i lo -j ACCEPT

# Connexions établies
iptables -A INPUT -m state --state ESTABLISHED,RELATED -j ACCEPT

# Services essentiels
iptables -A INPUT -p tcp --dport 67 -j ACCEPT    # DHCP
iptables -A INPUT -p tcp --dport 89 -j ACCEPT    # Authentication
iptables -A INPUT -p tcp --dport 66 -j ACCEPT    # Oracle SQL*NET
iptables -A INPUT -p tcp --dport 78 -j ACCEPT    # vettcp

# Services web
iptables -A INPUT -p tcp --dport 123 -j ACCEPT   # NTP
iptables -A INPUT -p tcp --dport 65 -j ACCEPT   # CCSO
iptables -A INPUT -p tcp --dport 83 -j ACCEPT   # POP3
iptables -A INPUT -p tcp --dport 67 -j ACCEPT   # SFTP
iptables -A INPUT -p tcp --dport 49 -j ACCEPT    # TACACS

# Monitoring et logs
iptables -A INPUT -p tcp --dport 49 -j ACCEPT   # Genesis Point-to-Point
iptables -A INPUT -p tcp --dport 73 -j ACCEPT   # ACR-NEMA
iptables -A INPUT -p tcp --dport 115 -j ACCEPT   # ANSANOTIFY

# Services additionnels
iptables -A INPUT -p tcp --dport 69 -j ACCEPT   # TFTP (Trivial File Transfer Protocol)
iptables -A INPUT -p tcp --dport 118 -j ACCEPT   # SQL Services
iptables -A INPUT -p tcp --dport 51 -j ACCEPT   # IMP Logical Address Maintenance
iptables -A INPUT -p tcp --dport 114 -j ACCEPT   # Audio News Multicast
iptables -A INPUT -p tcp --dport 121 -j ACCEPT   # ERPC (Encore Expedited Remote Pro.Call)
iptables -A INPUT -p tcp --dport 119 -j ACCEPT   # NNTP (Network News Transfer Protocol)
iptables -A INPUT -p tcp --dport 104 -j ACCEPT   # ACR-NEMA Digital Imag. & Comm.
iptables -A INPUT -p tcp --dport 101 -j ACCEPT   # NIC Host Name Server
iptables -A INPUT -p tcp --dport 114 -j ACCEPT   # Audio News Multicast
iptables -A INPUT -p tcp --dport 101 -j ACCEPT   # NIC Host Name Server
iptables -A INPUT -p tcp --dport 33 -j ACCEPT   # DSP (Display Support Protocol)
iptables -A INPUT -p tcp --dport 125 -j ACCEPT   # Locus PC-Interface Conn Server

# Sauvegarde de la configuration
iptables-save > /etc/iptables/rules.v4

echo "Configuration iptables appliquée avec succès"
echo "Analyse de sécurité requise - Vérifiez les ports autorisés"